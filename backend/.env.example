DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/danglish
# Hosted PostgreSQL example, using provider-supplied SSL settings when required:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only for local ingestion. Do not put this in the hosted backend env.
YOUTUBE_API_KEY=your-youtube-api-key
